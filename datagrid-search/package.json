{
  "name": "@astroapps/datagrid-search",
  "version": "0.2.1",
  "description": "Headless sort, filter and paging for @astroapps/datagrid, over @astroapps/searchstate state",
  "type": "module",
  "main": "lib/index.cjs",
  "module": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    "types": "./lib/index.d.ts",
    "require": "./lib/index.cjs",
    "default": "./lib/index.js"
  },
  "author": "Astrolabe Enterprises",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/astrolabe-apps/astrolabe-common/issues"
  },
  "homepage": "https://github.com/astrolabe-apps/astrolabe-common#readme",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "react",
    "datagrid",
    "search",
    "filter",
    "sort"
  ],
  "scripts": {
    "prepack": "npm run build",
    "build": "rimraf lib/ node_modules/.cache && microbundle -f modern,cjs --no-compress",
    "watch": "microbundle -f modern,cjs --no-compress",
    "test": "jest --coverage"
  },
  "peerDependencies": {
    "@astroapps/datagrid": "^1.3.0",
    "@astroapps/searchstate": "^2.1.0",
    "@react-typed-forms/core": "^4.6.0",
    "@tanstack/react-query": "^5.59.0",
    "react": "^18.2.0 || ^19"
  },
  "devDependencies": {
    "@astroapps/datagrid": "workspace:*",
    "@astroapps/searchstate": "workspace:*",
    "@jest/globals": "^29.7.0",
    "@react-typed-forms/core": "^4.6.0",
    "@react-typed-forms/transform": "^0.4.0",
    "@tanstack/react-query": "^5.59.0",
    "@testing-library/react": "^16.0.0",
    "@types/react": "^18.2.37",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "microbundle": "^0.15.1",
    "prettier": "^3.0.3",
    "react": "^18.2.0 || ^19",
    "rimraf": "^3.0.2",
    "ts-jest": "^29.2.5",
    "typescript": "^5.6.2"
  }
}
